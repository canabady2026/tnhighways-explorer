# Base URL of the deployed AWS API (tnhighways-api). Defaults to the
# already-deployed instance if unset, so this is only needed if you deploy
# your own copy of the backend.
NEXT_PUBLIC_API_BASE_URL=https://au80g7fdk7.execute-api.ap-south-1.amazonaws.com

# Set at build time only when deploying to a GitHub Pages *project* site
# (served from https://<user>.github.io/<repo>/). Leave unset for local
# dev or a user/org root site. The GitHub Actions workflow sets this
# automatically from the repository name -- you shouldn't need it locally.
# NEXT_BASE_PATH=/tnhighways-explorer
